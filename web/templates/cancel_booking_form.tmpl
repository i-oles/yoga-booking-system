<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>odwołanie rezerwacji</title>
    <script src="https://unpkg.com/htmx.org/dist/htmx.min.js"></script>
    <link rel="stylesheet" href="/web/static/css/styles.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600&family=Manrope:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
</head>
<div id="cancellation-container">
    <div class="cancellation-card">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64"
            viewBox="0 0 24 24" style="margin: 40 auto; display: block;">
            <circle cx="12" cy="12" r="12" fill="#f39c12"/>
            <rect x="10.8" y="6" width="2.4" height="8" rx="1.2" fill="#fff"/>
            <circle cx="12" cy="17" r="1.4" fill="#fff"/>
        </svg>
        <h4 style="text-align: center; margin-bottom: 40px;">Odwołanie rezerwacji!</h4>
        <div class="class-info">
            <div class="class-title">{{ .Class.ClassName }}</div>
            <table>
                <tr>
                    <td>poziom:</td>
                    <td>{{ .Class.ClassLevel }}</td>
                </tr>
                <tr>
                    <td>dzień:</td>
                    <td>{{ .Class.WeekDay }}</td>
                </tr>
                <tr>
                    <td>data:</td>
                    <td>{{ .Class.StartDate }}</td>
                </tr>
                <tr>
                    <td>godzina:</td>
                    <td>{{ .Class.StartHour }}</td>
                </tr>
                <tr>
                    <td>gdzie:</td>
                    <td>{{ .Class.Location }}</td>
                </tr>
            </table>
            <button
                type="submit"
                class="btn-cancel"
                hx-delete="/bookings/{{ .BookingID }}?token={{ .ConfirmationToken }}"
                hx-swap="outerHTML"
                hx-target="#cancellation-container"> 
                    <span class="btn-content">
                        <span class="submit-text">odwołuję</span>
                        <span class="htmx-indicator spinner"></span>
                    </span>
            </button>
        </div>
    </div>
</div>
<script>
    document.addEventListener('htmx:beforeSwap', function(event) {
        if (event.detail.xhr.status >= 400) {
            event.detail.shouldSwap = true;  // force swap
            event.detail.isError = false;    // treat as proper resp
        }
    });
</script>
